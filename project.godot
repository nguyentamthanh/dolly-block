; Godot 4 project configuration for the Dolly Blocks clone.
config_version=5

[application]
config/name="Cozy Blocks"
config/description="A grid puzzle where every block has feelings about colors."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")


[display]
; Portrait phone target. Board scales to fit whatever the device gives us.
window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
