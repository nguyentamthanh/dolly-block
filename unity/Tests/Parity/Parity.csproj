<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the Unity port's engine-free code (Core + audio synths) as a plain .NET console app, so its output can be
    compared with the TypeScript build without a Unity licence. Run through `npm run test:unity`.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0162;CS0168;CS0219;CS0414;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../Assets/Scripts/Core/*.cs" />
    <Compile Include="../../Assets/Scripts/Audio/SfxSynth.cs" />
    <Compile Include="../../Assets/Scripts/Audio/MusicSynth.cs" />
  </ItemGroup>
</Project>
